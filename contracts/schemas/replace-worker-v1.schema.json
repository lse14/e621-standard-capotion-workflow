{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anima://contracts/replace-worker-v1",
  "$defs": {
    "projection": {
      "type": "object",
      "required": ["quality", "count", "character", "series", "artist", "appearance", "tags", "environment", "nl"],
      "properties": {
        "quality": {"$ref": "#/$defs/tagArray"}, "count": {"enum": ["", "solo", "duo", "trio", "group"]},
        "character": {"type": "string", "maxLength": 16384}, "series": {"type": "string", "maxLength": 16384},
        "artist": {"type": "string", "maxLength": 16384}, "appearance": {"$ref": "#/$defs/tagArray"},
        "tags": {"$ref": "#/$defs/tagArray"}, "environment": {"$ref": "#/$defs/tagArray"}, "nl": {"type": "string", "maxLength": 16384}
      },
      "additionalProperties": false
    },
    "tagArray": {"type": "array", "maxItems": 16384, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^,\\r\\n\\u0000]+$"}}
  },
  "oneOf": [
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "jobId", "configHash", "resourceManifestRelativePath", "resourceFingerprint"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "replace_hello_request"}, "jobId": {"type": "string"}, "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "resourceManifestRelativePath": {"type": "string", "minLength": 1}, "resourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "jobId", "configHash", "customIndexOverlayRoot", "customIndexPath", "customIndexSha256", "customIndexRuleCount"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "replace_hello_request"}, "jobId": {"type": "string"}, "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "customIndexOverlayRoot": {"type": "string", "minLength": 1}, "customIndexPath": {"type": "string", "minLength": 1}, "customIndexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "customIndexRuleCount": {"type": "integer", "minimum": 1, "maximum": 250000}}, "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "ready", "indexLoads", "ruleCount", "resourceFingerprint", "keepNonCanonical", "canonicalDirectionConflict"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "replace_hello_result"}, "ready": {"const": true}, "indexLoads": {"const": 1}, "ruleCount": {"type": "integer", "minimum": 1, "maximum": 250000}, "resourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "keepNonCanonical": {"type": "integer", "minimum": 0}, "canonicalDirectionConflict": {"type": "integer", "minimum": 0}}, "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "items"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "replace_process_request"}, "items": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["schemaVersion", "sampleId", "leaseId", "source", "relativeImagePath", "projection"], "properties": {"schemaVersion": {"const": 1}, "sampleId": {"type": "integer", "minimum": 1}, "leaseId": {"type": "string"}, "source": {"const": "e621"}, "relativeImagePath": {"type": "string", "minLength": 1}, "projection": {"$ref": "#/$defs/projection"}}, "additionalProperties": false}}}, "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "sampleId", "leaseId", "source", "relativeImagePath", "projection", "replaced", "dropped", "passthrough", "keepRewritten"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "replace_result"}, "sampleId": {"type": "integer", "minimum": 1}, "leaseId": {"type": "string"}, "source": {"const": "e621"}, "relativeImagePath": {"type": "string", "minLength": 1}, "projection": {"$ref": "#/$defs/projection"}, "replaced": {"type": "integer", "minimum": 0, "maximum": 81920}, "dropped": {"type": "integer", "minimum": 0, "maximum": 81920}, "passthrough": {"type": "integer", "minimum": 0, "maximum": 81920}, "keepRewritten": {"type": "integer", "minimum": 0, "maximum": 81920}}, "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "sampleId", "leaseId", "source", "relativeImagePath", "code", "severity", "blocking", "retriable", "message"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "replace_issue"}, "sampleId": {"type": "integer", "minimum": 1}, "leaseId": {"type": "string"}, "source": {"const": "e621"}, "relativeImagePath": {"type": "string", "minLength": 1}, "code": {"const": "replace_json_invalid"}, "severity": {"const": "error"}, "blocking": {"const": true}, "retriable": {"const": false}, "message": {"type": "string", "minLength": 1, "maxLength": 1024}}, "additionalProperties": false
    }
  ]
}
