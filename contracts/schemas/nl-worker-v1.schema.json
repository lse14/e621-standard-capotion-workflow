{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anima://contracts/nl-worker-v1",
  "$defs": {
    "legacyItem": {
      "type": "object",
      "required": ["schemaVersion", "sampleId", "leaseId", "relativeImagePath", "imagePath", "jsonContext"],
      "properties": {
        "schemaVersion": {"const": 1}, "sampleId": {"type": "integer", "minimum": 1},
        "leaseId": {"type": "string", "minLength": 1, "maxLength": 128},
        "relativeImagePath": {"type": "string", "minLength": 1, "maxLength": 16384},
        "imagePath": {"type": ["string", "null"]}, "jsonContext": {"type": ["string", "null"], "maxLength": 262144}
      },
      "additionalProperties": false
    },
    "ocrContext": {
      "type": "object", "required": ["items"],
      "properties": {
        "items": {
          "type": "array", "maxItems": 1024,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "prefixItems": [
              {"enum": ["top-left", "top-center", "top-right", "middle-left", "middle-center", "middle-right", "bottom-left", "bottom-center", "bottom-right"]},
              {"type": "string", "minLength": 1, "maxLength": 16384}
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "v5Item": {
      "type": "object",
      "required": ["schemaVersion", "sampleId", "leaseId", "relativeImagePath", "imagePath", "jsonContext", "ocrContext"],
      "properties": {
        "schemaVersion": {"const": 1}, "sampleId": {"type": "integer", "minimum": 1},
        "leaseId": {"type": "string", "minLength": 1, "maxLength": 128},
        "relativeImagePath": {"type": "string", "minLength": 1, "maxLength": 16384},
        "imagePath": {"type": ["string", "null"]}, "jsonContext": {"type": ["string", "null"], "maxLength": 262144},
        "ocrContext": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ocrContext"}]}
      },
      "additionalProperties": false
    },
    "v6Item": {
      "type": "object",
      "required": ["schemaVersion", "sampleId", "leaseId", "relativeImagePath", "imagePath", "captionPreset", "lengthTier", "primaryCharacterName", "userSupplement", "jsonContext", "ocrContext"],
      "properties": {
        "schemaVersion": {"const": 1}, "sampleId": {"type": "integer", "minimum": 1},
        "leaseId": {"type": "string", "minLength": 1, "maxLength": 128},
        "relativeImagePath": {"type": "string", "minLength": 1, "maxLength": 16384},
        "imagePath": {"type": ["string", "null"]},
        "captionPreset": {"enum": ["general", "style", "character"]},
        "lengthTier": {"enum": ["short", "medium", "long"]},
        "primaryCharacterName": {"type": ["string", "null"], "maxLength": 512},
        "userSupplement": {"type": "string", "maxLength": 16384},
        "jsonContext": {"type": ["string", "null"], "maxLength": 262144},
        "ocrContext": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ocrContext"}]}
      },
      "allOf": [
        {"if": {"properties": {"captionPreset": {"const": "character"}}, "required": ["captionPreset"]}, "then": {"properties": {"primaryCharacterName": {"type": "string", "minLength": 1}}, "required": ["primaryCharacterName"]}},
        {"if": {"properties": {"captionPreset": {"enum": ["general", "style"]}}, "required": ["captionPreset"]}, "then": {"properties": {"primaryCharacterName": {"type": "null"}}, "required": ["primaryCharacterName"]}}
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["concurrency", "maxRequestsPerMinute", "mainAttempts", "backupEnabled", "backupAttempts", "connectTimeoutSeconds", "writeTimeoutSeconds", "readTimeoutSeconds", "poolTimeoutSeconds", "temperature", "topP", "maxTokens", "maxImagePixels", "maxImageSide", "jpegQuality", "maxEncodedImageBytes", "maxJsonContextBytes", "maxResponseBodyBytes", "maxNlBytes"],
      "properties": {
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "maxRequestsPerMinute": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "unlimited"}]},
        "mainAttempts": {"type": "integer", "minimum": 1, "maximum": 3}, "backupEnabled": {"type": "boolean"}, "backupAttempts": {"type": "integer", "minimum": 1, "maximum": 2},
        "connectTimeoutSeconds": {"type": "integer", "minimum": 1}, "writeTimeoutSeconds": {"type": "integer", "minimum": 1}, "readTimeoutSeconds": {"type": "integer", "minimum": 1}, "poolTimeoutSeconds": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2}, "topP": {"type": "number", "minimum": 0, "maximum": 2}, "maxTokens": {"type": "integer", "minimum": 1, "maximum": 16384},
        "maxImagePixels": {"const": 8000000}, "maxImageSide": {"const": 4096}, "jpegQuality": {"const": 95}, "maxEncodedImageBytes": {"const": 12582912}, "maxJsonContextBytes": {"const": 262144}, "maxResponseBodyBytes": {"const": 1048576}, "maxNlBytes": {"const": 16384}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "jobId", "configHash", "endpoint", "model", "backupModel", "apiKey", "systemPrompt", "apiPolicy"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "nl_hello_request"}, "jobId": {"type": "string", "minLength": 1}, "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "endpoint": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "backupModel": {"type": ["string", "null"]}, "apiKey": {"type": "string", "minLength": 1}, "systemPrompt": {"type": "string", "minLength": 1}, "apiPolicy": {"$ref": "#/$defs/policy"}},
      "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "jobId", "configHash", "endpoint", "model", "backupModel", "apiKey", "systemPrompt", "apiPolicy", "responseProtocol"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "nl_hello_request"}, "jobId": {"type": "string", "minLength": 1}, "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "endpoint": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "backupModel": {"type": ["string", "null"]}, "apiKey": {"type": "string", "minLength": 1}, "systemPrompt": {"type": "string", "minLength": 1}, "apiPolicy": {"$ref": "#/$defs/policy"}, "responseProtocol": {"const": "nl-count-v2"}},
      "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "jobId", "configHash", "endpoint", "model", "backupModel", "apiKey", "systemPrompt", "apiPolicy", "responseProtocol", "promptVersion"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "nl_hello_request"}, "jobId": {"type": "string", "minLength": 1}, "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "endpoint": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "backupModel": {"type": ["string", "null"]}, "apiKey": {"type": "string", "minLength": 1}, "systemPrompt": {"type": "string", "minLength": 1}, "apiPolicy": {"$ref": "#/$defs/policy"}, "responseProtocol": {"const": "nl-count-v2"}, "promptVersion": {"const": "nl-default-prompt-v3"}},
      "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "jobId", "configHash", "endpoint", "model", "backupModel", "apiKey", "systemPrompt", "apiPolicy", "responseProtocol", "promptVersion"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "nl_hello_request"}, "jobId": {"type": "string", "minLength": 1}, "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "endpoint": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "backupModel": {"type": ["string", "null"]}, "apiKey": {"type": "string", "minLength": 1}, "systemPrompt": {"type": "string", "minLength": 1}, "apiPolicy": {"$ref": "#/$defs/policy"}, "responseProtocol": {"const": "nl-count-v2"}, "promptVersion": {"const": "nl-default-prompt-v4"}},
      "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "ready", "concurrency"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "nl_hello_result"}, "ready": {"const": true}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 16}},
      "additionalProperties": false
    },
    {
      "type": "object", "required": ["schemaVersion", "payloadType", "items", "httpAttemptAllowance"],
      "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "nl_process_request"}, "httpAttemptAllowance": {"type": "integer", "minimum": 1, "maximum": 160}, "items": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"oneOf": [{"$ref": "#/$defs/legacyItem"}, {"$ref": "#/$defs/v5Item"}, {"$ref": "#/$defs/v6Item"}]}}},
      "additionalProperties": false
    }
  ]
}
