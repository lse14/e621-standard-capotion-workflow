{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anima://contracts/token-budget-worker-v1",
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenCount": {"type": "integer", "minimum": 0},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "captionFormat": {"type": "object", "required": ["replaceUnderscoresWithSpaces", "preserveEscapes", "triggersEnabled", "triggerTerms"], "properties": {"replaceUnderscoresWithSpaces": {"type": "boolean"}, "preserveEscapes": {"type": "boolean"}, "triggersEnabled": {"type": "boolean"}, "triggerTerms": {"$ref": "#/$defs/stringArray"}}, "additionalProperties": false},
    "annotation": {"type": "object", "required": ["quality", "count", "character", "series", "artist", "appearance", "tags", "environment", "nl"], "properties": {"quality": {"$ref": "#/$defs/stringArray"}, "count": {"type": "string"}, "character": {"type": "string"}, "series": {"type": "string"}, "artist": {"type": "string"}, "appearance": {"$ref": "#/$defs/stringArray"}, "tags": {"$ref": "#/$defs/stringArray"}, "environment": {"$ref": "#/$defs/stringArray"}, "nl": {"type": "string"}}, "additionalProperties": false},
    "removed": {"type": "object", "required": ["quality", "environment", "tags", "appearance"], "properties": {"quality": {"$ref": "#/$defs/stringArray"}, "environment": {"$ref": "#/$defs/stringArray"}, "tags": {"$ref": "#/$defs/stringArray"}, "appearance": {"$ref": "#/$defs/stringArray"}}, "additionalProperties": false},
    "committableOutcome": {"type": "object", "required": ["schemaVersion", "payloadType", "sampleId", "leaseId", "status", "originalTokens", "finalTokens", "removed", "annotation", "flatTextSha256"], "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "token_budget_outcome"}, "sampleId": {"type": "integer", "minimum": 1}, "leaseId": {"$ref": "#/$defs/identifier"}, "status": {"enum": ["within_budget", "trimmed"]}, "originalTokens": {"$ref": "#/$defs/tokenCount"}, "finalTokens": {"$ref": "#/$defs/tokenCount"}, "removed": {"$ref": "#/$defs/removed"}, "annotation": {"$ref": "#/$defs/annotation"}, "flatTextSha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "overflowOutcome": {"type": "object", "required": ["schemaVersion", "payloadType", "sampleId", "leaseId", "status", "originalTokens", "finalTokens", "removed"], "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "token_budget_outcome"}, "sampleId": {"type": "integer", "minimum": 1}, "leaseId": {"$ref": "#/$defs/identifier"}, "status": {"const": "overflow"}, "originalTokens": {"$ref": "#/$defs/tokenCount"}, "finalTokens": {"$ref": "#/$defs/tokenCount"}, "removed": {"$ref": "#/$defs/removed"}}, "additionalProperties": false},
    "failedOutcome": {"type": "object", "required": ["schemaVersion", "payloadType", "sampleId", "leaseId", "status", "code"], "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "token_budget_outcome"}, "sampleId": {"type": "integer", "minimum": 1}, "leaseId": {"$ref": "#/$defs/identifier"}, "status": {"const": "failed"}, "code": {"$ref": "#/$defs/identifier"}}, "additionalProperties": false},
    "outcome": {"oneOf": [{"$ref": "#/$defs/committableOutcome"}, {"$ref": "#/$defs/overflowOutcome"}, {"$ref": "#/$defs/failedOutcome"}]},
    "workItem": {"type": "object", "required": ["schemaVersion", "sampleId", "leaseId", "annotation"], "properties": {"schemaVersion": {"const": 1}, "sampleId": {"type": "integer", "minimum": 1}, "leaseId": {"$ref": "#/$defs/identifier"}, "annotation": {"type": "object"}}, "additionalProperties": false}
  },
  "oneOf": [
    {"type": "object", "required": ["schemaVersion", "payloadType", "jobId", "configHash", "resourceId", "resourceManifestRelativePath", "resourceFingerprint", "contextLimit", "maxTokens"], "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "token_budget_hello_request"}, "jobId": {"$ref": "#/$defs/identifier"}, "configHash": {"$ref": "#/$defs/sha256"}, "resourceId": {"enum": ["tokenizer-qwen3-0.6b-anima-v1", "tokenizer-qwen3-vl-4b-krea2-v1"]}, "resourceManifestRelativePath": {"type": "string", "minLength": 1}, "resourceFingerprint": {"$ref": "#/$defs/sha256"}, "contextLimit": {"type": "integer", "minimum": 1}, "maxTokens": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    {"type": "object", "required": ["schemaVersion", "payloadType", "ready", "resourceFingerprint", "contextLimit"], "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "token_budget_hello_result"}, "ready": {"const": true}, "resourceFingerprint": {"$ref": "#/$defs/sha256"}, "contextLimit": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    {"type": "object", "required": ["schemaVersion", "payloadType", "captionFormat", "items"], "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "token_budget_process_request"}, "captionFormat": {"$ref": "#/$defs/captionFormat"}, "items": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/workItem"}}}, "additionalProperties": false},
    {"$ref": "#/$defs/outcome"},
    {"type": "object", "required": ["schemaVersion", "payloadType", "outcomes"], "properties": {"schemaVersion": {"const": 1}, "payloadType": {"const": "token_budget_process_result"}, "outcomes": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/outcome"}}}, "additionalProperties": false}
  ]
}
