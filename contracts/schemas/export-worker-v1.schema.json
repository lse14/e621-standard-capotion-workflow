{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anima://contracts/export-worker-v1",
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[^\\u0000]+$"},
    "absolutePath": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[^\\u0000]+$"},
    "captionFormat": {
      "type": "object",
      "required": ["replaceUnderscoresWithSpaces", "preserveEscapes", "triggersEnabled", "triggerTerms"],
      "properties": {
        "replaceUnderscoresWithSpaces": {"type": "boolean"},
        "preserveEscapes": {"type": "boolean"},
        "triggersEnabled": {"type": "boolean"},
        "triggerTerms": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^,\\r\\n\\u0000]+$"}
        }
      },
      "additionalProperties": false
    },
    "workItem": {
      "type": "object",
      "required": ["schemaVersion", "sampleId", "leaseId", "relativeImagePath", "annotationKey"],
      "properties": {
        "schemaVersion": {"const": 1},
        "sampleId": {"type": "integer", "minimum": 1},
        "leaseId": {"$ref": "#/$defs/identifier"},
        "relativeImagePath": {"$ref": "#/$defs/relativePath"},
        "annotationKey": {"$ref": "#/$defs/relativePath"}
      },
      "additionalProperties": false
    },
    "conversions": {
      "type": "object",
      "description": "Frozen safe-conversion vocabulary; core/src/anima_core/export_summary.py:CONVERSION_CODES rejects any other key.",
      "properties": {
        "missing_field_defaulted": {"$ref": "#/$defs/conversionCount"},
        "array_empty_to_list": {"$ref": "#/$defs/conversionCount"},
        "array_string_split": {"$ref": "#/$defs/conversionCount"},
        "array_duplicate_removed": {"$ref": "#/$defs/conversionCount"},
        "string_empty_to_empty": {"$ref": "#/$defs/conversionCount"},
        "single_string_array_unwrapped": {"$ref": "#/$defs/conversionCount"},
        "character_duplicate_removed": {"$ref": "#/$defs/conversionCount"},
        "character_normalized": {"$ref": "#/$defs/conversionCount"}
      },
      "additionalProperties": false
    },
    "conversionCount": {"type": "integer", "minimum": 1, "maximum": 16384},
    "fieldError": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "field": {"type": ["null", "string"], "maxLength": 128},
        "code": {
          "enum": [
            "json_read_failed", "json_missing_or_blank", "json_too_large", "json_invalid_encoding",
            "json_syntax_invalid", "json_root_not_object", "field_type_invalid", "array_element_type_invalid",
            "extra_field", "tag_control_character", "cross_field_tag_collision", "tag_not_flat_txt_representable",
            "formatted_tag_collision", "trigger_tag_collision", "nl_control_character", "nl_too_large",
            "count_invalid", "payload_all_empty"
          ]
        }
      },
      "additionalProperties": false
    },
    "preparedOutcome": {
      "type": "object",
      "required": ["schemaVersion", "status", "sampleId", "leaseId", "relativeImagePath", "artifacts", "conversions"],
      "properties": {
        "schemaVersion": {"const": 1},
        "status": {"const": "prepared"},
        "sampleId": {"type": "integer", "minimum": 1},
        "leaseId": {"$ref": "#/$defs/identifier"},
        "relativeImagePath": {"$ref": "#/$defs/relativePath"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["kind", "relativePath", "sha256"],
            "properties": {
              "kind": {"enum": ["json", "txt"]},
              "relativePath": {"$ref": "#/$defs/relativePath"},
              "sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        },
        "conversions": {"$ref": "#/$defs/conversions"}
      },
      "additionalProperties": false
    },
    "issueOutcome": {
      "type": "object",
      "required": ["schemaVersion", "status", "sampleId", "leaseId", "relativeImagePath", "code", "fieldErrors"],
      "properties": {
        "schemaVersion": {"const": 1},
        "status": {"const": "issue"},
        "sampleId": {"type": "integer", "minimum": 1},
        "leaseId": {"$ref": "#/$defs/identifier"},
        "relativeImagePath": {"$ref": "#/$defs/relativePath"},
        "code": {"const": "final_json_invalid"},
        "fieldErrors": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/fieldError"}}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "payloadType", "jobId", "configHash", "datasetRoot", "overlayRoot", "format", "captionFormat"],
      "properties": {
        "schemaVersion": {"const": 1},
        "payloadType": {"const": "export_hello_request"},
        "jobId": {"$ref": "#/$defs/identifier"},
        "configHash": {"$ref": "#/$defs/sha256"},
        "datasetRoot": {"$ref": "#/$defs/absolutePath"},
        "overlayRoot": {"$ref": "#/$defs/absolutePath"},
        "format": {"enum": ["json", "flat_txt", "both"]},
        "captionFormat": {"$ref": "#/$defs/captionFormat"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "payloadType", "ready"],
      "properties": {
        "schemaVersion": {"const": 1},
        "payloadType": {"const": "export_hello_result"},
        "ready": {"const": true}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "payloadType", "items"],
      "properties": {
        "schemaVersion": {"const": 1},
        "payloadType": {"const": "export_process_request"},
        "items": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/workItem"}}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "payloadType", "outcomes"],
      "properties": {
        "schemaVersion": {"const": 1},
        "payloadType": {"const": "export_batch_result"},
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {"oneOf": [{"$ref": "#/$defs/preparedOutcome"}, {"$ref": "#/$defs/issueOutcome"}]}
        }
      },
      "additionalProperties": false
    }
  ]
}
